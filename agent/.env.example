# MQTT 服务器地址（巴法云填 bemfa.com，自建 EMQX/Mosquitto 填实际 IP 或域名）
MQTT_HOST=bemfa.com

# MQTT 端口（巴法云 9501，标准 Broker 默认 1883）
MQTT_PORT=9501

# Agent 端 Client ID
# 注意：标准 Broker 需使用与 ESP32 不同的 Client ID；巴法云则填写相同私钥
MQTT_CLIENT_ID=replace_with_your_client_id_or_bemfa_uid

# 可选认证账密（巴法云或匿名 Broker 留空即可）
MQTT_USER=
MQTT_PASS=

# 上行主题（与 ESP32 的 topic_up 保持一致：读取虚拟 U 盘 in.txt）
MQTT_TOPIC_UP=hidUp004

# 下行主题（与 ESP32 的 topic_down 保持一致：发送键鼠 JSON 指令）
MQTT_TOPIC_DOWN=hidDown004

# 可选：mqtt_watcher.py 收到上行文本后回调的 Agent Webhook 地址
AGENT_WEBHOOK_URL=
